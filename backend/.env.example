# Server Port
PORT=4000

# PostgreSQL Database Connection URL (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icash?schema=public"

# Authentication Secrets
JWT_SECRET="icash-super-secure-production-jwt-secret-key-2026"
SESSION_SECRET="icash-session-cookie-encryption-secret-2026"

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173"

# SMS OTP Provider: console | twofactor | msg91 | twilio
SMS_PROVIDER="console"

# Email OTP Provider: console | smtp | resend
# NOTE: On Render (and many other PaaS hosts), outbound SMTP ports
# (25/465/587) are firewalled even on paid plans, so `smtp` will time out.
# Use `resend` (or another HTTP-API email provider) in production instead.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# --- Optional: SMTP fallback (only works on hosts that allow outbound SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Biometric Verification Provider: demo | production
BIOMETRIC_PROVIDER="demo"
BIOMETRIC_PROVIDER_URL=""
BIOMETRIC_API_KEY=""

# --- Optional External SMS Providers ---
TWOFACTOR_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
