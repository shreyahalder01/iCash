datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  MERCHANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum AccountType {
  SAVINGS
  CURRENT
  VIRTUAL
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  WITHDRAWAL
  DEPOSIT
  TRANSFER
  PAYMENT
  REFUND
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  CANCELLED
}

enum BiometricStatus {
  ENROLLED
  PENDING
  REVOKED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model User {
  id                      String                @id @default(uuid())
  full_name               String
  email                   String?               @unique
  phone                   String                @unique
  aadhaar_reference       String                @unique
  aadhaar_last4           String
  aadhaar_verified        Boolean               @default(true)
  password_hash           String
  emergency_pin_hash      String?
  dob                     DateTime?
  age                     Int?
  is_senior               Boolean               @default(false)
  emergency_contact_name  String?
  emergency_contact_phone String?
  role                    Role                  @default(USER)
  status                  UserStatus            @default(ACTIVE)
  failed_login_attempts   Int                   @default(0)
  locked_until            DateTime?
  created_at              DateTime              @default(now())
  updated_at              DateTime              @updatedAt
  last_login_at           DateTime?

  biometric_profile       BiometricProfile?
  accounts                BankAccount[]
  transactions            Transaction[]
  sessions                LoginSession[]
  security_events         SecurityEvent[]
  complaints              Complaint[]
  delegations             DelegatedWithdrawal[]
  merchant_profile        MerchantProfile?

  @@index([phone])
  @@index([aadhaar_last4])
  @@index([role])
}

model MerchantProfile {
  id              String           @id @default(uuid())
  user_id         String           @unique
  business_name   String
  settlement_acct String
  settled_balance Decimal          @default(0.00) @db.Decimal(12, 2)
  pending_balance Decimal          @default(0.00) @db.Decimal(12, 2)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_requests PaymentRequest[]
}

model PaymentRequest {
  id             String          @id @default(uuid())
  merchant_id    String
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("INR")
  description    String?
  status         String          @default("PENDING") // PENDING, PAID, EXPIRED
  reference_code String          @unique
  created_at     DateTime        @default(now())
  expires_at     DateTime

  merchant       MerchantProfile @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
}

model BiometricProfile {
  id                  String          @id @default(uuid())
  user_id             String          @unique
  biometric_provider  String          @default("DEMO_FACIAL_EMBEDDINGS")
  biometric_reference String          @unique
  enrollment_status   BiometricStatus @default(ENROLLED)
  face_descriptors    Json?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model BankAccount {
  id                    String        @id @default(uuid())
  user_id               String
  bank_name             String
  account_number_masked String
  account_reference     String        @unique
  account_type          AccountType   @default(SAVINGS)
  balance               Decimal       @default(0.00) @db.Decimal(12, 2)
  currency              String        @default("INR")
  is_primary            Boolean       @default(false)
  status                AccountStatus @default(ACTIVE)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  user                  User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions          Transaction[]

  @@index([user_id])
}

model Transaction {
  id                String            @id @default(uuid())
  user_id           String
  account_id        String
  transaction_type  TransactionType
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("INR")
  description       String
  status            TransactionStatus @default(COMPLETED)
  reference_number  String            @unique
  recipient_name    String?
  recipient_account String?
  created_at        DateTime          @default(now())

  user              User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account           BankAccount       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  complaints        Complaint[]

  @@index([user_id])
  @@index([account_id])
  @@index([created_at])
}

model LoginSession {
  id                String    @id @default(uuid())
  user_id           String
  session_reference String    @unique
  device_reference  String?
  ip_address        String?
  user_agent        String?
  created_at        DateTime  @default(now())
  expires_at        DateTime
  revoked_at        DateTime?

  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_reference])
}

model SecurityEvent {
  id               String   @id @default(uuid())
  user_id          String?
  event_type       String
  severity         Severity @default(LOW)
  description      String
  ip_address       String?
  device_reference String?
  created_at       DateTime @default(now())

  user             User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([event_type])
  @@index([severity])
  @@index([created_at])
}

model Complaint {
  id             String          @id @default(uuid())
  user_id        String
  transaction_id String?
  subject        String
  description    String
  status         ComplaintStatus @default(OPEN)
  admin_response String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction    Transaction?    @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
}

model DelegatedWithdrawal {
  id         String   @id @default(uuid())
  user_id    String
  amount     Decimal  @db.Decimal(12, 2)
  otp_hash   String
  status     String   @default("PENDING") // PENDING, USED, EXPIRED
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}
