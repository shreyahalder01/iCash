{
  "name": "icash-backend",
  "version": "2.0.0",
  "description": "Production-grade backend for iCash biometric banking with PostgreSQL, Prisma, JWT/Cookie auth, Argon2/bcrypt security, and REST APIs.",
  "main": "backend/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm run prisma:generate",
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "liveness": "python liveness_server/app.py",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "prisma:seed": "node backend/prisma/seed.js",
    "test": "npm --prefix backend test",
    "lint:js": "eslint \"**/*.js\" --ext .js",
    "lint:js:fix": "eslint \"**/*.js\" --ext .js --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\""
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "appwrite": "^26.2.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
