{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "plugins": ["prettier"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "prettier/prettier": ["error", { "endOfLine": "auto" }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true,
        "node": true
      }
    },
    {
      "files": ["frontend/**/*.js"],
      "env": {
        "browser": true
      },
      "globals": {
        "faceapi": "readonly",
        "goTo": "readonly",
        "startCamera": "readonly",
        "stopCamera": "readonly",
        "openModal": "readonly",
        "closeModal": "readonly",
        "showMatch": "readonly",
        "currentUser": "writable",
        "promptLoginPin": "readonly",
        "executePendingAction": "readonly",
        "pendingVerificationAction": "writable",
        "showAlertToast": "readonly",
        "cameraErrorMessage": "readonly",
        "beginRegisterScan": "readonly",
        "beginLoginScan": "readonly",
        "launchBiometricGate": "readonly",
        "resendOtp": "readonly",
        "proceedToOtp": "readonly",
        "cancelOtp": "readonly",
        "submitLoginPin": "readonly",
        "attemptPinDirectLogin": "readonly",
        "toggleSidebar": "readonly",
        "handleCommandInput": "readonly",
        "closeDrawer": "readonly",
        "showTransactionDetails": "readonly",
        "setAmt": "readonly",
        "startLogin": "readonly",
        "startRegistration": "readonly",
        "formatAadhaar": "readonly",
        "handleDobChange": "readonly",
        "launchBiometricGate": "readonly",
        "teardownVerifyGate": "readonly",
        "toggleVerifyPin": "readonly",
        "submitVerifyPin": "readonly",
        "loadComplaintsList": "readonly",
        "submitInlineComplaint": "readonly",
        "submitComplaint": "readonly",
        "switchTransferMode": "readonly",
        "switchModalSendMode": "readonly",
        "handleTransferPhoneInput": "readonly",
        "handleSendPhoneInput": "readonly",
        "initiateTransferWorkflow": "readonly",
        "confirmSend": "readonly",
        "openDepositModal": "readonly",
        "confirmDeposit": "readonly",
        "confirmWithdraw": "readonly",
        "submitAddAccount": "readonly",
        "setPrimaryAccount": "readonly",
        "openDeleteAccountModal": "readonly",
        "confirmDeleteAccount": "readonly",
        "openDelegateCollectModal": "readonly",
        "closeEmergencyWithdrawalModal": "readonly",
        "submitEmergencyWithdrawalRequest": "readonly",
        "submitEmergencyWithdrawalOtp": "readonly",
        "submitPaymentRequest": "readonly",
        "logout": "readonly",
        "promptLoginPin": "readonly",
        "verifyAadhaarLogin": "readonly",
        "toggleBalanceVisibility": "readonly",
        "filterTransactions": "readonly",
        "handleTransactionSearch": "readonly",
        "prevPage": "readonly",
        "nextPage": "readonly",
        "exportStatement": "readonly",
        "createScanRingRenderer": "readonly",
        "addRegistrationEmergencyContactRow": "readonly",
        "captureVerifyFace": "readonly",
        "cancelVerify": "readonly",
        "FaceMesh": "readonly",
        "THREE": "readonly",
        "Appwrite": "readonly"
      },
      "rules": {
        "no-empty": "off",
        "no-unused-vars": "off"
      }
    }
  ]
}
